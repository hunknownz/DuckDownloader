{
  "name": "duckdownloader",
  "version": "0.1.0",
  "description": "A local CLI for Scribd, WeChat articles and authorized Feishu documents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "duckdownloader": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:live": "tsx scripts/run-integration-tests.ts live",
    "test:browser": "tsx scripts/run-integration-tests.ts browser",
    "browser:install": "tsx scripts/install-browser.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "camoufox": "0.5.8",
    "commander": "15.0.0",
    "linkedom": "0.18.13",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1",
    "turndown": "7.2.4",
    "plist": "5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
